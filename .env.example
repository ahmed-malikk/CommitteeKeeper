# Copy to .env.local (git-ignored) and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Test accounts used only by scripts/check-security.mjs (create them in Supabase, Authentication, Add user)
CK_TEST_ORG_A_EMAIL=
CK_TEST_ORG_A_PASSWORD=
CK_TEST_ORG_B_EMAIL=
CK_TEST_ORG_B_PASSWORD=
CK_TEST_MEMBER_EMAIL=
CK_TEST_MEMBER_PASSWORD=

# The daily reminder job. CRON_SECRET: any long random text (Vercel sends it as a Bearer token).
# SUPABASE_SECRET_KEY: server-only, never in git; used by the daily job and by receipt links for members without an account.
# BREVO_API_KEY and MAIL_FROM: optional; without them the job sends nothing and the Reminders page says email is not set up.
CRON_SECRET
SUPABASE_SECRET_KEY
BREVO_API_KEY
MAIL_FROM
